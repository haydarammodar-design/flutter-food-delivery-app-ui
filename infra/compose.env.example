# Docker Compose local-development values. Copy to .env at the repository root.
POSTGRES_DB=delivery_platform
POSTGRES_USER=delivery
POSTGRES_PASSWORD=replace-with-a-local-only-password
JWT_SECRET=replace-with-a-long-local-development-secret
SEED_PASSWORD=replace-with-a-local-seed-password
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-local-admin-password
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
NEXT_PUBLIC_API_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000

# Add real credentials only to the untracked root .env file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
