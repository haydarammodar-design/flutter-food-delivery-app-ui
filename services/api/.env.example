# Server
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
API_DOCUMENTATION_ENABLED=true

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/food_delivery?schema=public

# Authentication. Use a unique value outside local development.
JWT_SECRET=replace-with-a-long-local-development-secret
JWT_EXPIRES_IN=7d

# Prisma demo seed data. Replace before sharing any non-local environment.
SEED_PASSWORD=replace-with-local-demo-password
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-local-admin-password

# Redis / BullMQ. Disabled by default so Redis is optional for local API startup.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Media. Local image uploads work in development; configure Cloudinary for hosted uploads.
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage settings, reserved for an S3 media adapter.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# Push notifications
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FCM_SERVER_KEY=
