generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANT
  COURIER
  ADMIN
}

enum MembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum MerchantType {
  RESTAURANT
  GROCERY
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  CASH
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  OFFERED
  ACCEPTED
  ARRIVED
  PICKED_UP
  DELIVERED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  passwordHash        String
  firstName           String
  lastName            String?
  phone               String?
  role                Role                 @default(CUSTOMER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  merchantMemberships MerchantMembership[]
  addresses           Address[]
  customerOrders      Order[]              @relation("CustomerOrders")
  courierOrders       Order[]              @relation("CourierOrders")
  statusChanges       OrderStatusHistory[] @relation("StatusChangedBy")
  courierDeliveries   Delivery[]           @relation("CourierDeliveries")
  deliveryStatusChanges DeliveryStatusHistory[] @relation("DeliveryStatusChangedBy")
  courierProfile      CourierProfile?

  @@index([role])
}

model Merchant {
  id                       String               @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String               @unique
  type                     MerchantType
  description              String?
  contactEmail             String
  phone                    String?
  streetAddress            String?
  city                     String?
  state                    String?
  postalCode               String?
  countryCode              String               @default("US") @db.Char(2)
  latitude                 Decimal?             @db.Decimal(10, 7)
  longitude                Decimal?             @db.Decimal(10, 7)
  logoUrl                  String?
  coverImageUrl            String?
  minimumOrderAmount       Decimal              @default(0) @db.Decimal(10, 2)
  deliveryFee              Decimal              @default(0) @db.Decimal(10, 2)
  estimatedDeliveryMinutes Int                  @default(30)
  isActive                 Boolean              @default(true)
  isOpen                   Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  memberships              MerchantMembership[]
  products                 CatalogProduct[]
  orders                   Order[]

  @@index([type, isActive])
}

model MerchantMembership {
  id         String         @id @default(uuid()) @db.Uuid
  merchantId String         @db.Uuid
  userId     String         @db.Uuid
  role       MembershipRole @default(STAFF)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([merchantId, userId])
  @@index([userId, isActive])
}

model Category {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  products    CatalogProduct[]

  @@index([isActive, sortOrder])
}

model CatalogProduct {
  id                 String      @id @default(uuid()) @db.Uuid
  merchantId         String      @db.Uuid
  categoryId         String?     @db.Uuid
  sku                String
  name               String
  description        String?
  imageUrl           String?
  price              Decimal     @db.Decimal(10, 2)
  compareAtPrice     Decimal?    @db.Decimal(10, 2)
  currency           String      @default("USD") @db.Char(3)
  tags               String[]    @default([])
  isPublished        Boolean     @default(false)
  isAvailable        Boolean     @default(true)
  trackInventory     Boolean     @default(true)
  inventoryQuantity  Int         @default(0)
  lowStockThreshold  Int         @default(0)
  allowSubstitutions Boolean     @default(false)
  substitutionNote   String?
  sortOrder          Int         @default(0)
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  merchant           Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  category           Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]

  @@unique([merchantId, sku])
  @@index([merchantId, isPublished, deletedAt])
  @@index([categoryId, isPublished])
}

model Address {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  type          AddressType @default(HOME)
  label         String
  recipientName String
  phone         String?
  line1         String
  line2         String?
  city          String
  state         String?
  postalCode    String?
  countryCode   String      @default("US") @db.Char(2)
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  deliveryNotes String?
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]     @relation("DeliveryAddress")

  @@unique([userId, label])
  @@index([userId, isDefault])
}

model Order {
  id                      String               @id @default(uuid()) @db.Uuid
  orderNumber             String               @unique
  customerId              String               @db.Uuid
  merchantId              String               @db.Uuid
  courierId               String?              @db.Uuid
  deliveryAddressId       String?              @db.Uuid
  deliveryAddressSnapshot Json
  status                  OrderStatus          @default(PENDING_PAYMENT)
  currency                String               @default("USD") @db.Char(3)
  subtotal                Decimal              @db.Decimal(10, 2)
  deliveryFee             Decimal              @default(0) @db.Decimal(10, 2)
  serviceFee              Decimal              @default(0) @db.Decimal(10, 2)
  tax                     Decimal              @default(0) @db.Decimal(10, 2)
  discount                Decimal              @default(0) @db.Decimal(10, 2)
  totalAmount             Decimal              @db.Decimal(10, 2)
  customerNotes           String?
  placedAt                DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  customer                User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  merchant                Merchant             @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  courier                 User?                @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)
  deliveryAddress         Address?             @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]
  payments                Payment[]
  delivery                Delivery?

  @@index([customerId, createdAt])
  @@index([merchantId, status, createdAt])
  @@index([courierId, status])
}

model OrderItem {
  id                    String         @id @default(uuid()) @db.Uuid
  orderId               String         @db.Uuid
  productId             String         @db.Uuid
  productName           String
  productSku            String
  quantity              Int
  unitPrice             Decimal        @db.Decimal(10, 2)
  totalPrice            Decimal        @db.Decimal(10, 2)
  substitutionAllowed   Boolean        @default(false)
  substitutionPreference String?
  specialInstructions   String?
  createdAt             DateTime       @default(now())
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  changedById String?     @db.Uuid
  sequence    Int
  status      OrderStatus
  note        String?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([orderId, sequence])
  @@index([orderId, createdAt])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider
  externalId        String?         @unique
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @db.Char(3)
  failureCode       String?
  failureMessage    String?
  providerResponse  Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model Delivery {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @unique @db.Uuid
  courierId   String?         @db.Uuid
  status      DeliveryStatus  @default(OFFERED)
  earnings    Decimal         @default(0) @db.Decimal(10, 2)
  distanceKm  Decimal         @default(0) @db.Decimal(8, 2)
  etaMinutes  Int             @default(0)
  pickupNote  String?
  dropoffNote String?
  offeredAt   DateTime        @default(now())
  acceptedAt  DateTime?
  arrivedAt   DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier     User?           @relation("CourierDeliveries", fields: [courierId], references: [id], onDelete: SetNull)
  statusHistory DeliveryStatusHistory[]

  @@index([status, courierId])
  @@index([courierId, updatedAt])
}

model DeliveryStatusHistory {
  id             String         @id @default(uuid()) @db.Uuid
  deliveryId     String         @db.Uuid
  changedById    String?        @db.Uuid
  sequence       Int
  previousStatus DeliveryStatus?
  status         DeliveryStatus
  note           String?
  createdAt      DateTime       @default(now())
  delivery       Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  changedBy      User?          @relation("DeliveryStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([deliveryId, sequence])
  @@index([deliveryId, createdAt])
}

model CourierProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @db.Uuid
  vehicleType    String?
  vehiclePlate   String?
  isAvailable    Boolean   @default(false)
  currentLatitude Decimal? @db.Decimal(10, 7)
  currentLongitude Decimal? @db.Decimal(10, 7)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
